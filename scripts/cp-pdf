#!/bin/sh
# Usage: cp-pdf FILE PAGE
#
# Lists FILE, a file under public/, as a page: writes PAGE (a .md under src/content/) with `file:` set to FILE's site path.
# Like cp, PAGE may be a folder, and the page is then named after FILE. Nothing is copied, and an existing page is never overwritten.
# The other fields a file page can use follow as comments, since an empty field would break the build.
#
#   cp-pdf public/notes/stacks.pdf src/content/notes/            # src/content/notes/stacks.md
#   cp-pdf public/notes/main.pdf src/content/notes/stacks.md
set -eu
die() { echo "cp-pdf: $*" >&2; exit 1; }
[ $# -eq 2 ] || die "usage: cp-pdf FILE PAGE"

[ -f "$1" ] || die "$1: no such file"
file=$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")

page=$2
if [ -d "$page" ]; then
  name=$(basename "$file"); page=${page%/}/${name%.*}.md
fi
case $page in *.md) ;; *) die "$2: must be a .md file or a folder" ;; esac
[ -d "$(dirname "$page")" ] || die "$(dirname "$page"): no such folder"
[ -e "$page" ] && die "$page: already exists"

# The site is the folder that holds src/content/; FILE must be in its public/.
folder=$(cd "$(dirname "$page")" && pwd -P)/
case $folder in */src/content/*) root=${folder%%/src/content/*} ;; *) die "$2: not under src/content/" ;; esac
case $file in "$root"/public/*) ;; *) die "$1: not under $root/public/" ;; esac

# The statuses of the folder's groups, if its index.md has any: the keys indented under `groups:`.
groups=$(cat "$(dirname "$page")"/index.md "$(dirname "$page")"/index.mdx 2>/dev/null | awk '
  /^---/ { fence++; next }
  fence != 1 { next }
  /^groups:[[:space:]]*(#.*)?$/ { listing = 1; next }
  listing && /^[[:space:]]+[^#[:space:]][^:]*:/ { sub(/^[[:space:]]+/, ""); sub(/:.*/, ""); printf "%s%s", separator, $0; separator = ", "; next }
  !/^[[:space:]]/ { listing = 0 }')
if [ -n "$groups" ]; then
  status=$(printf '%-30s # required in this folder: one of %s' "# status: ${groups%%,*}" "$groups")
else
  status=$(printf '%-30s # shown next to the date; sorts the page into its folder'"'"'s groups, if it has any' '# status: Draft')
fi
date=$(printf '%-30s # publication date; dated pages are listed newest first' "# date: $(date +%Y-%m-%d)")

title=$(basename "$page" .md)
cat > "$page" <<PAGE
---
title: $title
file: ${file#"$root"/public}
# Optional fields: delete the leading # to use one. Leave a field out rather than empty.
# description: One sentence.   # shown under the title, in listings, search and link previews
$date
$status
# wip: true                    # marks the file as in progress
# tags: [mathematics]          # shown on the page and in listings; searchable
# authors: A. Author           # byline under the title, and in listings
# venue: arXiv 2503.01234      # shown next to the date, and in listings
# order: 10                    # position among its siblings; lower comes first
# draft: true                  # keeps the page off the site
---
PAGE
echo "$page"

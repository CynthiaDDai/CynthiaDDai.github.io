---
import EdgeLinks from './EdgeLinks.astro';
import Paired from '../content/Paired.astro';
import { site } from '../../config';
interface Props { path: string; }
const { path } = Astro.props;
---
<aside class="edge-navigation">
  <div class="edge-menu">
    <button class="edge-handle" type="button" data-toggle-edge aria-label="Explore the site" aria-expanded="false" aria-controls="desktop-edge-links"><svg class="edge-lantern" viewBox="0 0 16 26" aria-hidden="true"><path d="M8 0v3.5" /><rect x="5" y="3.5" width="6" height="2" rx=".6" /><ellipse class="edge-lantern-glow" cx="8" cy="11.5" rx="6" ry="6" /><path d="M8 5.5v12M4.6 6.6q-1.8 4.9 0 9.8M11.4 6.6q1.8 4.9 0 9.8" /><rect x="5" y="17.5" width="6" height="2" rx=".6" /><path d="M8 19.5v5M6.4 20.5v3.5M9.6 20.5v3.5" /></svg><span class="edge-label"><Paired text="index" motto={site.mottos?.index} class="edge-paired" /></span><span class="edge-mark" aria-hidden="true">+</span></button>
    <nav id="desktop-edge-links" aria-label="Explore the site"><EdgeLinks path={path} /></nav>
  </div>
</aside>
